#!/bin/bash
install_java8() {
    codename=$(_os_codename)
    distribution=$(_os_distro)
    if [[ $distribution == "ubuntu" ]]; then
        apt_install openjdk-8-jre
    elif [[ $distribution == "debian" ]]; then
        case $codename in
            *)
                echo_progress_start "Adding Adoptium repository"
                mkdir -p /etc/apt/keyrings
                rm -f /etc/apt/sources.list.d/adoptopenjdk.list
                curl -fsSL https://packages.adoptium.net/artifactory/api/gpg/key/public | gpg --yes --dearmor -o /etc/apt/keyrings/adoptium.gpg 2>> "${log}"
                echo "deb [signed-by=/etc/apt/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb ${codename} main" > /etc/apt/sources.list.d/adoptium.list
                echo_progress_done "Adoptium repos enabled"
                apt_update
                apt_install temurin-8-jdk
                ;;
        esac
    fi
}
